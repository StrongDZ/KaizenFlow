# infra/compose/.env (git-ignored) overrides host ports and holds the
# credentials of the local stack. `make up` creates it: gen-env.sh writes a
# random value for every credential that is not set. Set one by hand only to
# keep a value you already use.

# EMQX_MQTT_PORT=1883
# EMQX_DASHBOARD_PORT=18083
# REDPANDA_ADMIN_PORT=9644
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# RTSP_PORT=8554

# POSTGRES_USER=gauge
# POSTGRES_PASSWORD=<generated>
# POSTGRES_DB=gauge
# MINIO_ROOT_USER=gauge
# MINIO_ROOT_PASSWORD=<generated>
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=<generated>
# EMQX_COOKIE=<generated>
