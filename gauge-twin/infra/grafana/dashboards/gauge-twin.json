{
  "uid": "gauge-twin-server",
  "title": "gauge-twin: server pipeline",
  "tags": [
    "gauge-twin"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Messages per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(bridge_mqtt_messages_received_total[1m]))",
          "legendFormat": "bridge in (MQTT)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(bridge_kafka_messages_produced_total[1m]))",
          "legendFormat": "bridge out (Kafka)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(ingest_messages_total[1m])) by (result)",
          "legendFormat": "ingest {{result}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Kafka consumer lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_consumer_lag)",
          "legendFormat": "records behind"
        },
        {
          "refId": "B",
          "expr": "max(ingest_lag_seconds)",
          "legendFormat": "seconds behind"
        }
      ]
    },
    {
      "id": 3,
      "title": "End-to-end latency (window_end to ingested)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(ingest_end_to_end_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(ingest_end_to_end_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Bridge produce latency (MQTT receive to Kafka ack)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(bridge_kafka_produce_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(bridge_kafka_produce_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "title": "Edges online",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(edge_online)",
          "legendFormat": "online"
        }
      ]
    },
    {
      "id": 6,
      "title": "Bridge replicas subscribed",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 16,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bridge_mqtt_connected)",
          "legendFormat": "replicas"
        }
      ]
    },
    {
      "id": 7,
      "title": "Rejected by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ingest_rejected_total[5m])) by (reason)",
          "legendFormat": "{{reason}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ingest_messages_total{result=\"dlq\"}[5m]))",
          "legendFormat": "dead-lettered"
        }
      ]
    },
    {
      "id": 8,
      "title": "Reading flags",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(reading_flag_total[5m])) by (flag)",
          "legendFormat": "{{flag}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Rows: inserted vs duplicate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ingest_rows_total[1m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Sequence numbers lost / late",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(edge_seq_gap_total[1h]))",
          "legendFormat": "lost (1 h)"
        },
        {
          "refId": "B",
          "expr": "sum(increase(edge_seq_late_total[1h]))",
          "legendFormat": "late (1 h)"
        }
      ]
    },
    {
      "id": 11,
      "title": "Infrastructure errors and retries",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ingest_infra_errors_total[5m]))",
          "legendFormat": "ingest retries"
        },
        {
          "refId": "B",
          "expr": "sum(rate(bridge_kafka_produce_errors_total[5m]))",
          "legendFormat": "bridge produce errors"
        },
        {
          "refId": "C",
          "expr": "sum(config_api_unpublished_configs)",
          "legendFormat": "configs not yet published"
        }
      ]
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "editable": true
}
